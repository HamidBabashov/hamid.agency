APP_NAME="Hamid Agency"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Baku
APP_URL=https://hamid.agency

APP_LOCALE=az
APP_FALLBACK_LOCALE=az
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL (DirectAdmin → MySQL Management bölməsində yaradın)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=hamid_

# Email (DirectAdmin → E-mail Accounts; SMTP məlumatları)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.hamid.agency
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@hamid.agency"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── Admin hesabı (php artisan db:seed --class=AdminSeeder) ──
ADMIN_NAME="Hamid"
ADMIN_EMAIL=
# ən azı 10 simvol
ADMIN_PASSWORD=

# ── Agentlik əlaqə məlumatları ──
AGENCY_EMAIL=
AGENCY_PHONE=
# WhatsApp nömrəsi yalnız rəqəmlərlə: 994501234567
AGENCY_WHATSAPP=
AGENCY_ADDRESS=
# Sifariş və mesaj bildirişlərinin göndəriləcəyi ünvan
NOTIFY_EMAIL=
AGENCY_CURRENCY=AZN
AGENCY_CURRENCY_SYMBOL=₼

SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_LINKEDIN=
SOCIAL_GITHUB=

# ── Spam qorunması (Google reCAPTCHA v3, istəyə bağlı) ──
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
HONEYPOT_MIN_SECONDS=3

# ── Domen yoxlama provayderi: whois | resellerclub | namecheap | whmcs ──
DOMAIN_PROVIDER=whois
DOMAIN_CACHE_TTL=600

RESELLERCLUB_AUTH_USERID=
RESELLERCLUB_API_KEY=
RESELLERCLUB_SANDBOX=true

NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_SANDBOX=true

WHMCS_URL=
WHMCS_API_IDENTIFIER=
WHMCS_API_SECRET=

# ── SSH olmadan (FTP) deploy üçün: GitHub Secrets-dəki DEPLOY_TOKEN ilə eyni olmalıdır ──
DEPLOY_TOKEN=
